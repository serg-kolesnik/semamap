# Скопируйте в .env и поправьте. Файл .env в git не попадает.

# Папка с фотографиями на вашем компьютере (монтируется в контейнер только для чтения).
# Windows: PHOTOS_DIR=C:\Users\me\Pictures      Linux/macOS: PHOTOS_DIR=/home/me/Pictures
PHOTOS_DIR=

# Логин и пароль для доступа к карте. Обязательно задайте, если открываете сервер не только себе.
SEMAMAP_USER=
SEMAMAP_PASS=

# 127.0.0.1 — открыто только на этом компьютере; 0.0.0.0 — доступно из локальной сети (тогда нужен пароль).
SEMAMAP_BIND=127.0.0.1
SEMAMAP_PORT=8765

# Нужно только если индексировали на хосте (в базе пути Windows/хоста), а сервер запущен в контейнере.
# Формат: путь_на_хосте=/photos   (несколько пар — через ;)
# SEMAMAP_PATH_MAP=C:\Users\me\Pictures=/photos
SEMAMAP_PATH_MAP=
